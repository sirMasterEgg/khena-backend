# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Server
PORT=3000

# Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO)
# Pilih provider: s3 | r2 | minio  (gcs belum diimplementasikan)
STORAGE_PROVIDER=s3
S3_REGION=us-east-1
S3_BUCKET=khena-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Base URL public untuk mengakses file media (CDN atau public bucket).
# Tanpa trailing slash. Contoh: https://cdn.khena.com
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/khena-media

# Upload chunked (S3 Multipart): ukuran tiap part dalam byte.
# Minimal 5 MB (batasan S3), default 10 MB.
MULTIPART_PART_SIZE=10485760

# Auth
JWT_SECRET=ganti-dengan-random-string-panjang
ACCESS_TOKEN_TTL=900            # detik (15 menit)
REFRESH_TOKEN_TTL=1209600       # detik (14 hari)

# CSRF (signed double submit)
CSRF_SECRET=ganti-dengan-random-string-panjang-berbeda

# Pre-session (stateless signed cookie untuk mitigasi login CSRF)
PRE_SESSION_SECRET=ganti-dengan-random-string-panjang-lain
PRE_SESSION_TTL=1800            # detik (30 menit)

# Cookie
COOKIE_SECURE=false             # true di production (HTTPS)
COOKIE_DOMAIN=localhost

# Biteship (perhitungan ongkos kirim)
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com

# Better Auth (auth user website)
BETTER_AUTH_SECRET=ganti-dengan-random-string-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Origin frontend yang boleh mengirim request dengan cookie (CORS credentials).
# Wajib diisi eksplisit — wildcard `*` tidak boleh dipakai bersama credentials.
APP_PUBLIC_URL=http://localhost:3001
ADMIN_APP_URL=http://localhost:5173

# Mailer. Driver `console` hanya menulis isi email ke log server (development).
MAIL_DRIVER=console
MAIL_FROM=no-reply@khena.local
